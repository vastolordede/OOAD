SERVER_PORT=8080

DB_URL=jdbc:postgresql://localhost:5432/ooad_cosmetics
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME

JWT_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_SECRET_AT_LEAST_64_CHARACTERS
JWT_EXPIRATION_MS=86400000

CORS_ALLOWED_ORIGINS=http://localhost:5173

# A41 - Forgot/Reset Password.
# Keep RESET_EXPOSE_TOKEN=false outside local development.
RESET_TOKEN_EXPIRATION_MINUTES=30
RESET_EXPOSE_TOKEN=false

# P61 BONUS - Cloudinary image upload.
# The application still starts normally when this feature is disabled.
CLOUDINARY_ENABLED=false
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=ooad-cosmetics

# Leave false outside disposable local demos. Use the demo profile for simulated payments.
PAYMENT_SIMULATION_ENABLED=false

# VNPay sandbox (optional): configure your own merchant credentials locally.
# Configure /api/public/payment/vnpay/ipn as the merchant IPN URL in VNPay.
VNPAY_TMN_CODE=
VNPAY_HASH_SECRET=
VNPAY_PAY_URL=https://sandbox.vnpayment.vn/paymentv2/vpcpay.html
VNPAY_RETURN_URL=http://localhost:5173/payment/vnpay-return
VNPAY_EXPIRE_MINUTES=15
