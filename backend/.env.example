# Copy this file to .env and edit LOCAL values only.
# Never commit backend/.env.

SERVER_PORT=8080

DB_URL=jdbc:postgresql://localhost:5432/ooad_cosmetics
DB_USERNAME=postgres
DB_PASSWORD=CHANGE_ME

# Used from the authentication/JWT phase onward.
# Replace with a long random value before enabling JWT security.
JWT_SECRET=CHANGE_ME_USE_A_LONG_RANDOM_SECRET_AT_LEAST_64_CHARACTERS
JWT_EXPIRATION_MS=86400000

# React/Vite default development origin.
CORS_ALLOWED_ORIGINS=http://localhost:5173
